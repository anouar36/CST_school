                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Decorative elements -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-teal-300 rounded-full opacity-20 -mr-32 -mt-32"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-teal-300 rounded-full opacity-20 -ml-32 -mb-32"></div>
      
      <!-- Wave SVG for bottom curve -->
      <div class="absolute bottom-0 left-0 w-full">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120">
          <path fill="#ffffff" fill-opacity="1" d="M0,32L60,53.3C120,75,240,117,360,117.3C480,117,600,75,720,64C840,53,960,75,1080,80C1200,85,1320,75,1380,69.3L1440,64L1440,120L1380,120C1320,120,1200,120,1080,120C960,120,840,120,720,120C600,120,480,120,360,120C240,120,120,120,60,120L0,120Z"></path>
        </svg>
      </div>
    </div>

    <!-- Course Content -->
    <div class="container mx-auto px-4 py-12">
      <!-- Tabs -->
      <div class="mb-8 border-b">
        <div class="flex flex-wrap -mb-px">
          {# <button class="px-6 py-3 border-b-2 border-teal-500 text-teal-500 font-medium">Course Content</button> #}
          <button id='buttonReviews'  class="px-6 py-3 border-b-2 border-teal-500 text-teal-500 font-medium">Reviews</button>
          <button id='buttonExercises' class="px-6 py-3 text-gray-500 hover:text-gray-700">Exercises</button>
          <button id='buttonQuizzes' class="px-6 py-3 text-gray-500 hover:text-gray-700">Quizzes</button>
        </div>
      </div>
      

      <!-- Reviews Tab -->
      <div  id="ReviwsContent"  class="bg-white rounded-xl shadow-sm p-8">
        <div id="StudentReviews" class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
          <h2 class="text-2xl font-bold text-gray-800">Student Reviews </h2>
          <div class="mt-4 md:mt-0 flex items-center gap-4">
            <div class="flex items-center">
           
              <div class="flex mr-2">
              {# {% for i in 1..   %}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-400 fill-yellow-400" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              {% endfor %} #}

              {% for i in 1..5 %}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-400 {{ i <= assessment|round(1, 'floor') ? 'fill-yellow-400' : 'fill-gray-300' }}" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              {% endfor %}

              </div>
              <span class="font-medium">{{assessment}}</span>
              <span class="text-gray-500 ml-1">({{countInteraction}} reviews)</span>
            </div>
            <button id='buttonAddReview' class="px-4  py-2 bg-teal-500 text-white rounded-full hover:bg-teal-400 transition-colors text-sm">
              Add Review
            </button>
          </div>
        </div>
        <!-- Review Form (Hidden by default) -->
          <div id="containerAddReview" class="mb-8 p-6 border border-gray-200 rounded-lg bg-gray-50 hidden">
            <h3 class="text-xl font-semibold mb-4">Write Your Review</h3>
            <form method="POST" action="/student/addReview">
              <input type="hidden" name="courseId" value="{{course.getCourseId}}">
              <div class="mb-4">
                <label class="block text-gray-700 mb-2">Your Rating</label>
$                <div class="flex space-x-1 star-rating">
