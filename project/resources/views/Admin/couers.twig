<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LoanTech Dashboard</title>
  <!-- Tailwind CSS via CDN -->
{# //   <script src="https://cdn.tailwindcss.com"></script> #}
      <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            zinc: {
              50: '#fafafa',
              100: '#f4f4f5',
              200: '#e4e4e7',
              300: '#d4d4d8',
              400: '#a1a1aa',
              500: '#71717a',
              600: '#52525b',
              700: '#3f3f46',
              800: '#27272a',
              900: '#18181b',
            }
          }
        }
      }
    }
  </script>
  <!-- Inter font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .scrollbar-none::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-none {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="bg-white dark:bg-[#0F0F12] text-gray-900 dark:text-white">
  <div class="flex h-screen" id="app-container">
    <!-- Sidebar -->
    <nav id="sidebar" class="fixed inset-y-0 left-0 z-[70] w-64 bg-white dark:bg-[#0F0F12] transform transition-transform duration-200 ease-in-out -translate-x-full lg:translate-x-0 lg:static lg:w-64 border-r border-gray-200 dark:border-[#1F1F23]">
      <div class="h-full flex flex-col">
        <a href="#" class="h-16 px-6 flex items-center border-b border-gray-200 dark:border-[#1F1F23] transition-all duration-200 hover:bg-gray-50 dark:hover:bg-gray-800/30">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg flex items-center justify-center font-bold text-lg transition-transform duration-200 hover:scale-110">
              LT
            </div>
            <span class="text-lg font-semibold hover:cursor-pointer text-gray-900 dark:text-white transition-colors duration-200 hover:text-blue-600 dark:hover:text-blue-400">
              LoanTech
            </span>
          </div>
        </a>

        <div class="flex-1 overflow-y-auto py-4 px-4">
          <div class="space-y-6">
            <div>
              <div class="px-3 mb-2 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
                Menu
              </div>
              <div class="space-y-1">
                <a href="/admin" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-[#1F1F23] hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                  </svg>
                  <span class="transition-all duration-200 group-hover:translate-x-1">Home</span>
                </a>
                <a href="#" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 bg-gray-100 text-gray-900 hover:bg-gray-200 hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                    <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
                    <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
                    <path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path>
                  </svg>
                  <span class="transition-all duration-200 group-hover:translate-x-1">Coures</span>
                </a>
                <a href="admin/tags" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-[#1F1F23] hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                    <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
                    <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
                    <path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path>
                  </svg>
                  <span class="transition-all duration-200 group-hover:translate-x-1">Tags</span>
                </a>
                <a href="#" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-[#1F1F23] hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                    <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                    <line x1="2" x2="22" y1="10" y2="10"></line>
                  </svg>
                  <span class="transition-all duration-200 group-hover:translate-x-1">Wallets</span>
                </a>
                <a href="#" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-[#1F1F23] hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span class="transition-all duration-200 group-hover:translate-x-1">History</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="px-4 py-4 border-t border-gray-200 dark:border-[#1F1F23]">
          <div class="space-y-1">
            <a href="#" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-[#1F1F23] hover:shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span class="transition-all duration-200 group-hover:translate-x-1">Settings</span>
            </a>
            <a href="#" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-[#1F1F23] hover:shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <path d="M12 17h.01"></path>
              </svg>
              <span class="transition-all duration-200 group-hover:translate-x-1">Help</span>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Mobile menu button -->
    <button id="mobile-menu-button" type="button" class="lg:hidden fixed top-4 left-4 z-[70] p-2 rounded-lg bg-white dark:bg-[#0F0F12] shadow-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-gray-600 dark:text-gray-300">
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </button>

    <!-- Mobile menu overlay -->
    <div id="mobile-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-[65] lg:hidden hidden"></div>

    <!-- Main content -->
    <div class="w-full flex flex-1 flex-col">
      <!-- Header -->
      <header class="h-16 border-b border-gray-200 dark:border-[#1F1F23]">
        <nav class="px-6 flex items-center justify-between bg-white dark:bg-[#0F0F12] h-full">
          <div class="font-medium text-sm flex items-center space-x-1">
            <div class="flex items-center">
              <a href="#" class="text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">
                Home
              </a>
            </div>
          </div>

          <div class="flex items-center gap-4">
            
            <div class="relative">
              <input
                type="text"
                placeholder="Search..."
                class="w-48 md:w-64 h-9 pl-9 pr-3 text-sm rounded-lg bg-gray-100 dark:bg-gray-800 border border-transparent focus:border-gray-300 dark:focus:border-gray-700 focus:outline-none transition-all"
              />
              <div class="absolute left-2 top-1/2 transform -translate-y-1/2 text-gray-500 dark:text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.3-4.3"></path>
                </svg>
              </div>
            </div>

            <button class="p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-gray-600 dark:text-gray-300">
                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
              </svg>
            </button>
            <div class="relative" id="profile-dropdown">
              <button id="profile-button" class="focus:outline-none">
                <div class="relative cursor-pointer block">
                  <img  src="../../../public/assets/images/{{user.getImage}}" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rounded-full ring-4 ring-white dark:ring-zinc-900 object-cover">
                    <circle cx="12" cy="8" r="5"></circle>
                    <path d="M20 21a8 8 0 1 0-16 0"></path>
                  </svg>
                </div>
              </button>
              <div id="profile-menu" class="hidden absolute right-0 mt-2 w-56 bg-white dark:bg-zinc-900 rounded-lg shadow-lg border border-zinc-200 dark:border-zinc-800 z-50">
                <div class="w-full max-w-sm mx-auto">
                  <div class="relative overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800">
                    <div class="relative px-6 pt-12 pb-6">
                      <div class="flex items-center gap-4 mb-8">
                        <!-- Replace your existing profile image div with this: -->
                        <form action="saveImage" method="post" enctype="multipart/form-data"  class="relative">
                          <!-- Hidden file input -->
                          <input type="file" id="profile-image-upload" name="image" class="hidden" />
                          
                          <!-- Profile image with label to trigger file selection -->
                          <label for="profile-image-upload" class="relative cursor-pointer block">
                            <img 
                              src="../../../public/assets/images/{{user.getImage}}" 
                              alt="Profile Image" 
                              width="72" 
                              height="72" 
                              class="rounded-full ring-4 ring-white dark:ring-zinc-900 object-cover"
                              id="profile-image"
                            />
                            
                            <!-- Hover overlay with camera icon -->
                            <div class="absolute inset-0 bg-black/50 rounded-full opacity-0 hover:opacity-100 flex items-center justify-center transition-opacity">
                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-white">
                                <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path>
                                <circle cx="12" cy="13" r="3"></circle>
                              </svg>
                            </div>
                            
                            <!-- Status indicator (green dot) -->
                            <div class="absolute bottom-0 right-0 w-4 h-4 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-zinc-900"></div>
                          </label>
                          
                          <!-- Submit button - hidden initially, can be shown after file selection with JavaScript -->
                          <button 
                            type="submit" 
                            class="absolute bottom-0 right-0 w-8 h-8 rounded-full bg-blue-500 text-white flex items-center justify-center transform translate-x-1/2 translate-y-1/2 shadow-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-300 hidden"
                            id="submit-button"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                          </button>
                        </form>
                        <div class="flex-1">
                          <h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100">{{user.getName}}</h2>
                          <p class="text-zinc-600 dark:text-zinc-400">Prompt Engineer</p>
                        </div>
                      </div>
                      <div class="h-px bg-zinc-200 dark:bg-zinc-800 my-6"></div>
                      <div class="space-y-2">
                        <a href="#" class="flex items-center justify-between p-2 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 rounded-lg transition-colors duration-200">
                          <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                              <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                              <line x1="2" x2="22" y1="10" y2="10"></line>
                            </svg>
                            <span class="text-sm font-medium text-zinc-900 dark:text-zinc-100">Subscription</span>
                          </div>
                          <div class="flex items-center">
                            <span class="text-sm text-zinc-500 dark:text-zinc-400 mr-2">Free Trial</span>
                          </div>
                        </a>
                        <a href="#" class="flex items-center justify-between p-2 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 rounded-lg transition-colors duration-200">
                          <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                              <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                              <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <span class="text-sm font-medium text-zinc-900 dark:text-zinc-100">Settings</span>
                          </div>
                        </a>
                        <a href="#" class="flex items-center justify-between p-2 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 rounded-lg transition-colors duration-200">
                          <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                              <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                            <span class="text-sm font-medium text-zinc-900 dark:text-zinc-100">Terms & Policies</span>
                          </div>
                          <div class="flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                              <path d="M7 7h10v10"></path>
                              <path d="M7 17 17 7"></path>
                            </svg>
                          </div>
                        </a>
                        <button type="button" class="w-full flex items-center justify-between p-2 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 rounded-lg transition-colors duration-200">
                          <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                              <polyline points="16 17 21 12 16 7"></polyline>
                              <line x1="21" x2="9" y1="12" y2="12"></line>
                            </svg>
                            <span class="text-sm font-medium text-zinc-900 dark:text-zinc-100">Logout</span>
                          </div>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </nav>
      </header>

      <!-- Main content -->
      <main class="flex-1 overflow-auto p-6 bg-white dark:bg-[#0F0F12]">
        <div class="space-y-4">
          <!-- CSCS Active Banner -->
          <div class="bg-gradient-to-r from-blue-600 to-purple-600 dark:from-blue-950 dark:to-purple-950 text-white p-6 rounded-xl flex items-center justify-between transition-all duration-300 ease-in-out hover:shadow-lg hover:scale-[1.02]">
            <div class="flex items-center gap-3">
              <div class="bg-white/20 p-2 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>
              <div>
                <h3 class="font-medium">CSCS Active</h3>
                <p class="text-sm text-white/80">Your CSCS and CHN is now active, you can begin trading.</p>
              </div>
            </div>
            <button class="bg-white hover:bg-white/90 text-gray-900 px-6 py-2.5 rounded-lg text-sm font-medium transition-all duration-200 hover:shadow-md active:scale-95">
              Trade now
            </button>
          </div>

          <!-- Portfolio and Wallet Cards -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-white dark:bg-[#0F0F12] rounded-xl p-6 border border-gray-200 dark:border-[#1F1F23] transition-all duration-300 ease-in-out hover:shadow-md hover:border-gray-300 dark:hover:border-gray-700">
              <h2 class="text-sm text-gray-600 dark:text-gray-400 mb-2">Total Portfolio Value</h2>
              <div class="text-2xl font-bold mb-4">****</div>
              <button class="text-sm text-gray-900 dark:text-white flex items-center gap-2 transition-all duration-200 hover:gap-3">
                View portfolio
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </button>
            </div>

            <div class="bg-white dark:bg-[#0F0F12] rounded-xl p-6 border border-gray-200 dark:border-[#1F1F23] transition-all duration-300 ease-in-out hover:shadow-md hover:border-gray-300 dark:hover:border-gray-700">
              <h2 class="text-sm text-gray-600 dark:text-gray-400 mb-2">Wallet Value</h2>
              <div class="text-2xl font-bold mb-4">****</div>
