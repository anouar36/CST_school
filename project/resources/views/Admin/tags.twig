<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tags Management Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Inter font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .scrollbar-none::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-none {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .modal {
      display: none;
      position: fixed;
      z-index: 100;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgba(0,0,0,0.4);
    }
    .modal-content {
      background-color: #fefefe;
      margin: 10% auto;
      padding: 20px;
      border: 1px solid #e5e7eb;
      border-radius: 0.5rem;
      width: 90%;
      max-width: 500px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
  </style>
</head>
<body class="bg-white text-gray-900">
  <div class="flex h-screen" id="app-container">
    <!-- Sidebar -->
    <nav id="sidebar" class="fixed inset-y-0 left-0 z-[70] w-64 bg-white transform transition-transform duration-200 ease-in-out -translate-x-full lg:translate-x-0 lg:static lg:w-64 border-r border-gray-200">
      <div class="h-full flex flex-col">
        <a href="#" class="h-16 px-6 flex items-center border-b border-gray-200 transition-all duration-200 hover:bg-gray-50">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-gray-900 text-white rounded-lg flex items-center justify-center font-bold text-lg transition-transform duration-200 hover:scale-110">
              LT
            </div>
            <span class="text-lg font-semibold hover:cursor-pointer text-gray-900 transition-colors duration-200 hover:text-blue-600">
              LoanTech
            </span>
          </div>
        </a>

        <div class="flex-1 overflow-y-auto py-4 px-4">
          <div class="space-y-6">
            <div>
              <div class="px-3 mb-2 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Menu
              </div>
              <div class="space-y-1">
                <a href="/admin" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50 hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                  </svg>
                  <span class="transition-all duration-200 group-hover:translate-x-1">Home</span>
                </a>

                <a href="couers" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50 hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <path d="M3 9h18"></path>
                    <path d="M9 21V9"></path>
                  </svg>
                  <span class="transition-all duration-200 group-hover:translate-x-1">Courses</span>
                </a>
                <a href="#" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 bg-gray-100 text-gray-900 hover:bg-gray-200 hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                    <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
                    <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
                    <path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path>
                  </svg>
                  <span class="transition-all duration-200 group-hover:translate-x-1">Tags</span>
                </a>
                <a href="#" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50 hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                    <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                    <line x1="2" x2="22" y1="10" y2="10"></line>
                  </svg>
                  <span class="transition-all duration-200 group-hover:translate-x-1">Wallets</span>
                </a>
                <a href="#" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50 hover:shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span class="transition-all duration-200 group-hover:translate-x-1">History</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="px-4 py-4 border-t border-gray-200">
          <div class="space-y-1">
            <a href="#" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50 hover:shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span class="transition-all duration-200 group-hover:translate-x-1">Settings</span>
            </a>
            <a href="#" class="flex items-center px-3 py-2 text-sm rounded-md transition-all duration-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50 hover:shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-3 flex-shrink-0 transition-transform duration-200 group-hover:scale-110">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <path d="M12 17h.01"></path>
              </svg>
              <span class="transition-all duration-200 group-hover:translate-x-1">Help</span>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Mobile menu button -->
    <button id="mobile-menu-button" type="button" class="lg:hidden fixed top-4 left-4 z-[70] p-2 rounded-lg bg-white shadow-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-gray-600">
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </button>

    <!-- Mobile menu overlay -->
    <div id="mobile-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-[65] lg:hidden hidden"></div>

    <!-- Main content -->
    <div class="w-full flex flex-1 flex-col">
      <!-- Header -->
      <header class="h-16 border-b border-gray-200">
        <nav class="px-6 flex items-center justify-between bg-white h-full">
          <div class="font-medium text-sm flex items-center space-x-1">
            <div class="flex items-center">
              <a href="#" class="text-gray-700 hover:text-gray-900 transition-colors">
                Home
              </a>
              <span class="mx-2 text-gray-400">/</span>
              <a href="#" class="text-gray-700 hover:text-gray-900 transition-colors">
                Tags
              </a>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="relative">
              <input
                type="text"
                placeholder="Search..."
                class="w-48 md:w-64 h-9 pl-9 pr-3 text-sm rounded-lg bg-gray-100 border border-transparent focus:border-gray-300 focus:outline-none transition-all"
              />
              <div class="absolute left-2 top-1/2 transform -translate-y-1/2 text-gray-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.3-4.3"></path>
                </svg>
              </div>
            </div>

            <button class="p-2 hover:bg-gray-100 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-gray-600">
                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
              </svg>
            </button>
            
            <div class="relative">
              <button class="relative cursor-pointer block rounded-full bg-gray-200 w-8 h-8 overflow-hidden">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-gray-600">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </button>
            </div>
          </div>
        </nav>
      </header>

      <!-- Main content -->
      <main class="flex-1 overflow-auto p-6 bg-white">
        <div class="space-y-6">
          <!-- Tags Management Header -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <h1 class="text-2xl font-bold">Tags Management</h1>
              <p class="text-gray-600 mt-1">
                Create and manage tags for your courses and content
              </p>
            </div>
            <div class="flex items-center gap-2">
              <button class="px-3 py-2 rounded-md border border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors duration-150 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" x2="12" y1="15" y2="3"></line>
                </svg>
                <span class="hidden sm:inline">Export</span>
              </button>
              <button id="create-tag-btn" class="px-3 py-2 rounded-md bg-blue-600 text-white hover:bg-blue-700 transition-colors duration-150 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                  <path d="M5 12h14"></path>
                  <path d="M12 5v14"></path>
                </svg>
                <span>Create Tag</span>
              </button>
            </div>
          </div>

          <!-- Tags Table -->
          <div class="bg-white rounded-xl p-6 border border-gray-200 transition-all duration-300 ease-in-out hover:shadow-md hover:border-gray-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
              <div class="relative w-full sm:w-64 md:w-80">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-gray-500">
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.3-4.3"></path>
                </svg>
                <input
                  placeholder="Search tags..."
                  class="w-full pl-9 pr-3 py-2 rounded-md border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>
              <div class="text-sm text-gray-500">
                Showing <span class="font-medium">5</span> tags
              </div>
            </div>
            
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Name
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Use by
                    </th>
                    
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Created
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Status
                    </th>
                    <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Actions
                    </th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <!-- Tag 1 -->
                   {% for tag in tags %}
                  <tr class="hover:bg-gray-50 transition-colors duration-150">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm font-medium text-gray-900">
                         {{tag.getName}}
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <div class="text-sm text-gray-500 max-w-xs truncate">
                        {{tag.getUsage_count}}
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 py-1 text-xs font-medium rounded-full border border-gray-200 text-gray-700">
                         {{tag.getName}}
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                     {{tag.getDate_creation}}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                    {% if tag.getIsActive  %}
                      <div class="flex items-center">
                        <label class="inline-flex items-center cursor-pointer">
                          <input type="checkbox" checked class="sr-only peer">
                          <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600"></div>
                        </label>
                        <span class="ml-2 px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">
                          Active
                        </span>
                        {% else %}  
                        <div class="flex items-center">
                        <label class="inline-flex items-center cursor-pointer">
                          <input type="checkbox"  class="sr-only peer">
                          <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600"></div>
                        </label>
                         <span class="ml-2 px-2 py-1 text-xs font-medium rounded-full border border-gray-200 text-gray-700">
                          Inactive
                        </span>
                        {% endif %}
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    
                      <div class="flex justify-end gap-2">
                        <button class="edit-tag-btn p-1 rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100" data-id = "{{tag.getId}}"  data-name="{{tag.getName}}" data-description="{{tag.getId}}" data-category="Business" data-active= "{{tag.getIsActive}}">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                            <path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                            <path d="m15 5 4 4"></path>
                          </svg>
                        </button>
                       
                        <a href="deleteTag/{{ tag.getId }}" class="p-1 rounded-md text-blue-500 hover:text-blue-700 hover:bg-blue-50">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                            <path d="M3 6h18"></path>
                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0-2 1-2 2v2"></path>
                          </svg>
                        </a>
                      </div>
                    </td>
                  </tr>
                   {% endfor %}
       
            <!-- Pagination -->
            <div class="flex items-center justify-between mt-6">
              <div class="text-sm text-gray-500">
                Showing <span class="font-medium">1</span> to <span class="font-medium">5</span> of <span class="font-medium">5</span> results
              </div>
              <div class="flex space-x-2">
                <button class="px-3 py-1 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors duration-150 opacity-50 cursor-not-allowed">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                    <path d="m15 18-6-6 6-6"></path>
                  </svg>
                </button>
                <button class="px-3 py-1 rounded-md bg-blue-600 text-white hover:bg-blue-700 transition-colors duration-150">
                  1
                </button>
                <button class="px-3 py-1 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors duration-150 opacity-50 cursor-not-allowed">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                    <path d="m9 18 6-6-6-6"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Create Tag Modal -->
  <div id="create-tag-modal" class="modal">
    <div class="modal-content">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold">Create New Tag</h3>
        <button id="close-create-modal" class="text-gray-500 hover:text-gray-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <form id="create-tag-form" action="create/tage" method="post">
        <div class="space-y-4">
          <div>
            <label for="tag-name" class="block text-sm font-medium text-gray-700 mb-1">Tag Name</label>
            <input type="text" id="tag-name" name="tag-name" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" required>
          </div>
          <div class="flex items-center">
            <label class="inline-flex items-center cursor-pointer">
              <input type="checkbox" id="tag-active" name="tag-active" checked class="sr-only peer">
              <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              <span class="ml-3 text-sm font-medium text-gray-700">Active</span>
            </label>
          </div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
          <button type="button" id="cancel-create" class="px-4 py-2 bg-white border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 bg-blue-600 border border-transparent rounded-md text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Create Tag
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Tag Modal -->
  <div id="edit-tag-modal" class="modal">
    <div class="modal-content">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold">Edit Tag</h3>
        <button id="close-edit-modal" class="text-gray-500 hover:text-gray-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <form id="edit-tag-form" Actions="updateTag" method="post">
        <input type="hidden" name="edit-tag-id" id="edit-tag-id">
        <div class="space-y-4">
          <div>
            <label for="edit-tag-name" class="block text-sm font-medium text-gray-700 mb-1">Tag Name</label>
            <input type="text" id="edit-tag-name" name="edit-tag-name" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" required>
          </div>
          
          
          <div class="flex items-center">
            <label class="inline-flex items-center cursor-pointer">
              <input type="checkbox" id="edit-tag-active" name="edit-tag-active" class="sr-only peer">
              <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              <span class="ml-3 text-sm font-medium text-gray-700">Active</span>
            </label>
          </div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
          <button type="button" id="cancel-edit" class="px-4 py-2 bg-white border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 bg-blue-600 border border-transparent rounded-md text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Mobile menu functionality
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const sidebar = document.getElementById('sidebar');
    const mobileOverlay = document.getElementById('mobile-overlay');
    
    mobileMenuButton.addEventListener('click', () => {
      sidebar.classList.toggle('-translate-x-full');
      mobileOverlay.classList.toggle('hidden');
    });
    
    mobileOverlay.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
      mobileOverlay.classList.add('hidden');
    });
    
    // Modal functionality
    const createTagBtn = document.getElementById('create-tag-btn');
    const createTagModal = document.getElementById('create-tag-modal');
    const closeCreateModal = document.getElementById('close-create-modal');
    const cancelCreate = document.getElementById('cancel-create');
    
    const editTagBtns = document.querySelectorAll('.edit-tag-btn');
    const editTagModal = document.getElementById('edit-tag-modal');
    const closeEditModal = document.getElementById('close-edit-modal');
    const cancelEdit = document.getElementById('cancel-edit');
    
    // Create Tag Modal
    createTagBtn.addEventListener('click', () => {
      createTagModal.style.display = 'block';
    });
    
    closeCreateModal.addEventListener('click', () => {
      createTagModal.style.display = 'none';
    });
    
    cancelCreate.addEventListener('click', () => {
      createTagModal.style.display = 'none';
    });
    
    // Edit Tag Modal
    editTagBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        const active = btn.getAttribute('data-active') ;
        console.log(id);
        console.log(name);
        console.log(active);
        document.getElementById('edit-tag-id').value = id;
        document.getElementById('edit-tag-name').value = name;
        if(active == 1){
          document.getElementById('edit-tag-active').checked = active;
        }else{
          document.getElementById('edit-tag-active').checked = false;
        }
        
        editTagModal.style.display = 'block';
      });
    });
    
    closeEditModal.addEventListener('click', () => {
      editTagModal.style.display = 'none';
    });
    
    cancelEdit.addEventListener('click', () => {
      editTagModal.style.display = 'none';
    });
    
    // Close modals when clicking outside
    window.addEventListener('click', (event) => {
      if (event.target === createTagModal) {
        createTagModal.style.display = 'none';
      }
      if (event.target === editTagModal) {
        editTagModal.style.display = 'none';
      }
    });
    
    
  </script>
</body>
</html>